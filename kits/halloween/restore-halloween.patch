        the pills); each .bottom-nav-group carries its own pill look
        (background, blur, border, shadow, sheen) — previously all of
        that lived on #bottom-nav directly. */
+    /* ── Halloween ─────────────────────────────────────────
+       The jack-o'-lantern floats free in the gap between the two pills,
+       bobbing on its own; lit, its face glows. The theme itself is the
+       dark one re-pitched (body.dark.halloween re-defines the dark tokens)
+       plus a still layer of cobwebs, a moon and a few bats behind the nav. */
+    /* A smaller pumpkin perched on the top edge of the Home page's
+       Category / Brand switch, rocking a little (Halloween only). */
+    body.halloween #homeViewToggle { position:relative; }
+    /* For now (trying it out): no avatar on the name, nor its orbits, while
+       it's Halloween. */
+    body.halloween .avatar-overlay-slot, body.halloween .hdr-orbits { display:none; }
+    .hwp-perch { display:none; position:absolute; left:calc(42% - 15px); bottom:calc(100% - 7px); width:30px; height:30px; pointer-events:none; transform-origin:50% 92%; animation:hwpRock 3.2s ease-in-out infinite; filter:drop-shadow(0 0 8px rgba(255,120,20,.4)) drop-shadow(0 3px 3px rgba(0,0,0,.45)); }
+    body.halloween .hwp-perch { display:block; }
+    .hwp-perch svg { display:block; width:100%; height:100%; overflow:visible; }
+    .hwp-perch .hw-body { fill:#ff8a1e; }
+    .hwp-perch .hw-rib { fill:none; stroke:#d9620b; stroke-width:1.6; stroke-linecap:round; opacity:.8; }
+    .hwp-perch .hw-stem { fill:#5b7a2c; }
+    .hwp-perch .hw-leaf { fill:#7da23b; }
+    .hwp-perch .hw-face { fill:#ffd36b; filter:drop-shadow(0 0 2px #ffb02e); animation:hwFlicker 3.4s steps(1) infinite; }
+    @keyframes hwpRock { 0%, 100% { transform:rotate(-5deg); } 50% { transform:rotate(5deg); } 72% { transform:rotate(1deg) translateY(-3px); } 80% { transform:rotate(-1deg) translateY(0); } }
+    @media (prefers-reduced-motion:reduce) { .hwp-perch, .hwp-perch .hw-face { animation:none; } }
+    #hw-btn {
+      position:relative; width:38px; height:38px; padding:0; margin:0 2px; border:0; background:transparent; cursor:pointer;
+      display:grid; place-items:center; -webkit-tap-highlight-color:transparent;
+      animation:hwFloat 3.6s ease-in-out infinite; filter:drop-shadow(0 6px 8px rgba(0,0,0,.18));
+    }
+    #hw-btn > svg { width:38px; height:38px; overflow:visible; transition:transform .25s cubic-bezier(.34,1.56,.64,1); }
+    #hw-btn:hover > svg { transform:scale(1.1) rotate(-6deg); }
+    #hw-btn:active > svg { transform:scale(.92); }
+    /* A little bat (looping Lottie, hw-bat.json) flapping at the pumpkin's
+       shoulder, overlapping it. Its line strokes take the text colour. */
+    #hw-btn .hw-btn-bat { position:absolute; right:-12px; top:-11px; width:27px; height:27px; pointer-events:none; color:#1a1a1a; z-index:1; }
+    body.dark #hw-btn .hw-btn-bat { color:#f4ecff; }
+    #hw-btn .hw-btn-bat svg [stroke]:not([stroke="none"]) { stroke:currentColor !important; }
+    #hw-btn:focus-visible { outline:2px solid #ff8a1e; outline-offset:4px; border-radius:50%; }
+    #hw-btn .hw-body { fill:#ff8a1e; }
+    #hw-btn .hw-rib { fill:none; stroke:#d9620b; stroke-width:1.4; stroke-linecap:round; opacity:.8; }
+    #hw-btn .hw-stem { fill:#5b7a2c; }
+    #hw-btn .hw-leaf { fill:#7da23b; }
+    #hw-btn .hw-face { fill:#4a2208; transition:fill .4s; }
+    body.halloween #hw-btn .hw-face { fill:#ffd36b; filter:drop-shadow(0 0 3px #ffb02e) drop-shadow(0 0 7px rgba(255,140,30,.8)); animation:hwFlicker 2.8s steps(1) infinite; }
+    body.halloween #hw-btn { filter:drop-shadow(0 0 14px rgba(255,120,20,.45)) drop-shadow(0 6px 8px rgba(0,0,0,.4)); }
+    .hw-tip {
+      position:absolute; bottom:calc(100% + 12px); left:50%; transform:translateX(-50%) translateY(4px); white-space:nowrap;
+      padding:5px 10px; border-radius:8px; background:#1a1a1a; color:#fff; font:500 11.5px/1 var(--font-body);
+      opacity:0; pointer-events:none; transition:opacity .2s, transform .2s;
+    }
+    #hw-btn:hover .hw-tip { opacity:1; transform:translateX(-50%); }
+    @keyframes hwFloat { 0%,100% { transform:translateY(0) rotate(-4deg); } 50% { transform:translateY(-7px) rotate(4deg); } }
+    @keyframes hwFlicker { 0%,100% { opacity:1; } 42% { opacity:.82; } 44% { opacity:1; } 71% { opacity:.9; } 73% { opacity:1; } }
+
+    body.dark.halloween {
+      --d-bg:#0f0a13; --d-surface:#1b1320; --d-raised:#271b2d;
+      --d-text:#f6ebdd; --d-text-2:#cdb6a2; --d-text-3:#938096;
+      --d-line:rgba(255,138,30,.13); --d-line-2:rgba(255,138,30,.24);
+      --thumb-a:#241a2a; --thumb-b:#1a1220;
+    }
+    body.halloween ::selection { background:#ff8a1e; color:#0f0a13; }
+    body.halloween .bottom-nav-group { background:rgba(32,18,36,.72); border-color:rgba(255,138,30,.22); }
+    #hw-layer { position:fixed; inset:0; z-index:150; pointer-events:none; display:none; overflow:hidden; }
+    body.halloween #hw-layer { display:block; }
+    #hw-layer .hw-glow { position:absolute; left:50%; bottom:-30vh; width:120vw; height:60vh; transform:translateX(-50%); background:radial-gradient(closest-side, rgba(255,110,20,.16), rgba(255,110,20,0)); }
+    /* The moon is a button, the kind sewn on for eyes in Coraline (in the blue
+       of her hair, so it shows on the dark): a
+       four-hole button with a raised rim, swaying a little; its halo turns
+       slowly from moonlight to blood red and back. Beside it floats a
+       needle, its thread trailing and drifting. */
+    /* Its size follows the screen: 84px on a phone, growing with the width
+       to --mb-max (170px unless edit mode sets hwButtonMax), reached at a
+       1600px-wide screen (--mb-vw), and it sits in from the edge (--mr); the
+       needle keeps its place and size beside it. */
+    #hw-layer { --mb:clamp(84px, var(--mb-vw, 10.6vw), var(--mb-max, 170px)); --mr:clamp(18px, 12vw, 240px); }
+    #hw-layer .hw-moon { position:absolute; top:6vh; right:var(--mr); width:var(--mb); height:var(--mb); border-radius:50%; animation:hwMoonGlow 16s ease-in-out infinite, hwMoonSway 7s ease-in-out infinite; }
+    #hw-layer .hw-moon svg { display:block; width:100%; height:100%; overflow:visible; }
+    @keyframes hwMoonSway { 0%, 100% { transform:rotate(-5deg); } 50% { transform:rotate(5deg); } }
+    #hw-layer .hw-needle { position:absolute; top:calc(6vh - var(--mb) * .1); right:calc(var(--mr) + var(--mb) * .795); width:calc(var(--mb) * .385); height:calc(var(--mb) * 1.23); overflow:visible; animation:hwNeedle 5.5s ease-in-out infinite; filter:drop-shadow(0 4px 6px rgba(0,0,0,.45)); }
+    @keyframes hwNeedle { 0%, 100% { transform:translateY(0) rotate(14deg); } 50% { transform:translateY(-9px) rotate(22deg); } }
